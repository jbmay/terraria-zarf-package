{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Terraria Zarf deployment values",
  "type": "object",
  "additionalProperties": false,
  "required": ["runtime", "terraria", "storage", "worldImport", "resources"],
  "properties": {
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["serverType", "image"],
      "properties": {
        "serverType": {
          "type": "string",
          "enum": ["tshock", "vanilla"]
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "tag", "pullPolicy"],
          "properties": {
            "repository": { "type": "string" },
            "tag": { "type": "string" },
            "pullPolicy": {
              "type": "string",
              "enum": ["Always", "IfNotPresent", "Never"]
            }
          }
        }
      },
      "oneOf": [
        {
          "properties": {
            "serverType": { "const": "tshock" },
            "image": {
              "properties": {
                "repository": { "const": "ghcr.io/jbmay/terraria-tshock" },
                "tag": { "const": "6.1.0-build.2" }
              }
            }
          }
        },
        {
          "properties": {
            "serverType": { "const": "vanilla" },
            "image": {
              "properties": {
                "repository": { "const": "ghcr.io/jbmay/terraria-vanilla" },
                "tag": { "const": "1.4.5.6-build.1" }
              }
            }
          }
        }
      ]
    },
    "terraria": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tty",
        "stdin",
        "service",
        "serverSettings",
        "extraServerSettings",
        "tshockSettings"
      ],
      "properties": {
        "tty": { "type": "boolean" },
        "stdin": { "type": "boolean" },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "port", "nodePort", "annotations"],
          "properties": {
            "type": {
              "type": "string",
              "enum": ["ClusterIP", "NodePort", "LoadBalancer"]
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "nodePort": {
              "type": ["integer", "null"],
              "minimum": 30000,
              "maximum": 32767
            },
            "annotations": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            }
          }
        },
        "serverSettings": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "worldname",
            "worldsize",
            "difficulty",
            "maxplayers",
            "secure",
            "language",
            "npcstream",
            "priority"
          ],
          "properties": {
            "worldname": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^/\\\\]+$"
            },
            "worldsize": {
              "type": "string",
              "enum": ["small", "medium", "large"]
            },
            "difficulty": {
              "type": "string",
              "enum": ["normal", "expert", "master", "journey"]
            },
            "maxplayers": {
              "type": "integer",
              "minimum": 1,
              "maximum": 255
            },
            "secure": {
              "type": "integer",
              "enum": [0, 1]
            },
            "language": {
              "type": "string",
              "minLength": 2
            },
            "npcstream": {
              "type": "integer",
              "minimum": 0
            },
            "priority": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5
            }
          }
        },
        "extraServerSettings": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "number", "integer", "boolean"]
          }
        },
        "tshockSettings": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "ServerName",
            "UseServerName",
            "ServerPassword",
            "RequireLogin",
            "MaxSlots"
          ],
          "properties": {
            "ServerName": { "type": "string" },
            "UseServerName": { "type": "boolean" },
            "ServerPassword": { "type": "string" },
            "RequireLogin": { "type": "boolean" },
            "MaxSlots": {
              "type": "integer",
              "minimum": 1,
              "maximum": 255
            }
          }
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["existingClaim", "accessMode", "size", "storageClass"],
      "properties": {
        "existingClaim": { "type": "string" },
        "accessMode": {
          "type": "string",
          "enum": ["ReadWriteOnce", "ReadWriteMany", "ReadOnlyMany", "ReadWriteOncePod"]
        },
        "size": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(Ei|Pi|Ti|Gi|Mi|Ki|E|P|T|G|M|K)$"
        },
        "storageClass": { "type": "string" }
      }
    },
    "worldImport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "image", "sourcePath", "overwrite"],
      "properties": {
        "enabled": { "type": "boolean" },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reference", "pullPolicy"],
          "properties": {
            "reference": { "type": "string" },
            "pullPolicy": {
              "type": "string",
              "enum": ["Always", "IfNotPresent", "Never"]
            }
          }
        },
        "sourcePath": {
          "type": "string",
          "pattern": "^/"
        },
        "overwrite": { "type": "boolean" }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests", "limits"],
      "properties": {
        "requests": { "$ref": "#/definitions/resources" },
        "limits": { "$ref": "#/definitions/resources" }
      }
    }
  },
  "definitions": {
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu", "memory"],
      "properties": {
        "cpu": {
          "type": "string",
          "pattern": "^([0-9]+m|[0-9]+(\\.[0-9]+)?)$"
        },
        "memory": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(Ei|Pi|Ti|Gi|Mi|Ki|E|P|T|G|M|K)$"
        }
      }
    }
  }
}

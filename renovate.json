{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "custom.regex"
  ],
  "dependencyDashboard": true,
  "automerge": false,
  "pinDigests": false,
  "packageRules": [
    {
      "matchDatasources": [
        "docker"
      ],
      "groupName": "package images",
      "groupSlug": "package-images"
    }
  ],
  "prBodyNotes": [
    "Renovate updates the package game-version prefix and README references while preserving the package build.N suffix. If only an image build or TShock changes and the game version stays the same, manually increment package build.N and README package references before merging. Verify the Maru build; published package versions are not overwritten.",
    "Confirm the vanilla image and TShock image support the intended Terraria version. BusyBox 1.36 is fixed by the published chart's init containers and requires a chart update before it can be changed."
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Keep all ghcr.io/jbmay/terraria-tshock image references synchronized",
      "managerFilePatterns": [
        "/^(?:zarf|values|helm-values|deploy-values\\.example|deploy-values\\.vanilla)\\.yaml$/",
        "/^values\\.schema\\.json$/"
      ],
      "matchStrings": [
        "-\\s+ghcr\\.io/jbmay/terraria-tshock:(?<currentValue>[A-Za-z0-9_.-]+)",
        "repository:\\s*[\"']?ghcr\\.io/jbmay/terraria-tshock[\"']?\\s+tag:\\s*[\"']?(?<currentValue>[A-Za-z0-9_.-]+)",
        "\"repository\":\\s*\\{\\s*\"const\":\\s*\"ghcr\\.io/jbmay/terraria-tshock\"\\s*\\},\\s*\"tag\":\\s*\\{\\s*\"const\":\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "ghcr.io/jbmay/terraria-tshock",
      "datasourceTemplate": "docker",
      "versioningTemplate": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-build\\.(?<build>\\d+)$"
    },
    {
      "customType": "regex",
      "description": "Keep all ghcr.io/jbmay/terraria-vanilla image references synchronized",
      "managerFilePatterns": [
        "/^(?:zarf|values|helm-values|deploy-values\\.example|deploy-values\\.vanilla)\\.yaml$/",
        "/^values\\.schema\\.json$/"
      ],
      "matchStrings": [
        "-\\s+ghcr\\.io/jbmay/terraria-vanilla:(?<currentValue>[A-Za-z0-9_.-]+)",
        "repository:\\s*[\"']?ghcr\\.io/jbmay/terraria-vanilla[\"']?\\s+tag:\\s*[\"']?(?<currentValue>[A-Za-z0-9_.-]+)",
        "\"repository\":\\s*\\{\\s*\"const\":\\s*\"ghcr\\.io/jbmay/terraria-vanilla\"\\s*\\},\\s*\"tag\":\\s*\\{\\s*\"const\":\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "ghcr.io/jbmay/terraria-vanilla",
      "datasourceTemplate": "docker",
      "versioningTemplate": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\.(?<build>\\d+)-build\\.(?<revision>\\d+)$"
    },
    {
      "customType": "regex",
      "description": "Update the package game version while preserving its independent build.N suffix",
      "managerFilePatterns": [
        "/^zarf\\.yaml$/"
      ],
      "matchStrings": [
        "version:\\s*(?<currentValue>\\d+\\.\\d+\\.\\d+\\.\\d+)-build\\.\\d+"
      ],
      "depNameTemplate": "ghcr.io/jbmay/terraria-vanilla",
      "datasourceTemplate": "docker",
      "versioningTemplate": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\.(?<build>\\d+)$",
      "extractVersionTemplate": "^(?<version>\\d+\\.\\d+\\.\\d+\\.\\d+)-build\\.\\d+$"
    },
    {
      "customType": "regex",
      "description": "Keep README package versions aligned with the game version",
      "managerFilePatterns": [
        "/^README\\.md$/"
      ],
      "matchStrings": [
        "(?<currentValue>\\d+\\.\\d+\\.\\d+\\.\\d+)-build\\.\\d+"
      ],
      "depNameTemplate": "ghcr.io/jbmay/terraria-vanilla",
      "datasourceTemplate": "docker",
      "versioningTemplate": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\.(?<build>\\d+)$",
      "extractVersionTemplate": "^(?<version>\\d+\\.\\d+\\.\\d+\\.\\d+)-build\\.\\d+$"
    }
  ]
}
